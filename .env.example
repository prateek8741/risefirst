# Copy to .env (repo root, used by docker compose) or backend/.env (used by `uv run` locally).

# --- AI tagging (optional) ---
# Without a key the pipeline runs on rules only and the site still works.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Maximum AI calls per daily run (cost and rate-limit guard). Unchanged jobs are never re-sent.
AI_CALL_BUDGET=300
AI_CONCURRENCY=4
# Calls are spaced to stay under this. Free tier: 5/min and about 20/day per model.
# When the daily quota runs out, AI pauses until the next run and jobs fall back to the rules.
# Enable billing on the Google project and raise this (e.g. 60) to process every unclear job.
AI_REQUESTS_PER_MINUTE=5

# --- Database ---
# Local development without Docker (docker compose sets its own):
DATABASE_URL=postgresql+psycopg://localhost:5432/risefirst

# --- Scheduler ---
# Hour of day (IST) for the daily refresh in the worker container.
REFRESH_HOUR_IST=6
